generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Experience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionGoal {
  CUT
  MAINTAIN
  BULK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  sex          String?
  experience   Experience?
  createdAt    DateTime @default(now())

  // Nutrition profile inputs — feed the macro calculator, not a body-comp
  // history (Checkin.weightKg is the tracked-over-time version of weight).
  weightKg      Float?
  heightCm      Float?
  // dateOfBirth is the source of truth where it's set; `age` is derived from
  // it on read. A stored age silently goes stale every birthday, which would
  // quietly drift the calorie maths — a birth date never does. `age` stays
  // for accounts that only ever gave a number.
  dateOfBirth   DateTime?
  age           Int?
  activityLevel ActivityLevel?
  nutritionGoal NutritionGoal?

  // First-run state. A null onboardedAt is what routes a new account into the
  // survey; tourCompletedAt is separate so someone can finish the survey, bail
  // out of the tour, and not be sent back through both.
  onboardedAt         DateTime?
  tourCompletedAt     DateTime?

  // Self-reported context from onboarding, all editable afterwards. `goals`
  // uses the same vocabulary the peptide reference is tagged with, so a stated
  // goal maps straight onto both peptides and nutrient priorities.
  goals               String[] @default([])
  medications         String[] @default([])
  usedPeptidesBefore  Boolean?
  priorExperienceNote String?

  appOpens       AppOpen[]
  refreshTokens  RefreshToken[]
  stackItems     StackItem[]
  checkins       Checkin[]
  nutritionPlans NutritionPlan[]
  nutritionLogs  NutritionLog[]
}

// Allows logging out of a single device and rotating refresh tokens without
// invalidating every session — a bare "one secret in the JWT" approach can't do that.
/*
One row per day the user opened the app.

A rest day asks nothing of the protocol, so there is no dose to log and
nothing that could prove the day was kept. Showing up is the only signal
available, which is why "days on protocol" counts it.

Stored as a date at midnight rather than a timestamp, with a unique
constraint on the pair, so repeated opens on one day collapse to a single
row and the streak can't be inflated by relaunching.
*/
model AppOpen {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@unique([userId, day])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model StackItem {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  peptideName  String
  dose         Float
  unit         String
  frequency    String
  scheduleDays Int[]
  route        String?
  startedAt    DateTime  @default(now())
  cycleOnDays  Int?
  cycleOffDays Int?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  injectionLogs InjectionLog[]

  @@index([userId])
}

model InjectionLog {
  id          String    @id @default(cuid())
  stackItemId String
  stackItem   StackItem @relation(fields: [stackItemId], references: [id], onDelete: Cascade)
  // Null for routes with nowhere to pin — oral capsules, nasal sprays. The
  // dose still happened, so the log still exists.
  site        String?
  takenAt     DateTime  @default(now())
  notes       String?

  @@index([stackItemId])
}

model Checkin {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg     Float?
  bodyFatPct   Float?
  energy       Int?
  mood         Int?
  notes        String?
  createdAt    DateTime @default(now())

  photos CheckinPhoto[]

  @@index([userId])
}

model CheckinPhoto {
  id        String  @id @default(cuid())
  checkinId String
  checkin   Checkin @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  angle     String // "front" | "side" | "back"
  url       String

  @@index([checkinId])
}

model NutritionPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  title     String
  content   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal      String
  notes     String?
  loggedAt  DateTime @default(now())

  @@index([userId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Experience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionGoal {
  CUT
  MAINTAIN
  BULK
}

/*
How often the user intends to check in.

Asked during onboarding and changeable afterwards, because the right answer
depends entirely on what someone is running. Weekly weigh-ins on an eight-week
cut and a two-year maintenance dose are not the same commitment, and an app
that asks daily of someone who meant to give it monthly is teaching them to
ignore it.

Not nullable, with a default. Every account has a cadence — the survey only
changes it — which keeps "has this been set yet" out of every screen that
reads it.
*/
enum CheckinCadence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  sex          String?
  experience   Experience?
  createdAt    DateTime @default(now())

  // Nutrition profile inputs — feed the macro calculator, not a body-comp
  // history (Checkin.weightKg is the tracked-over-time version of weight).
  weightKg      Float?
  heightCm      Float?
  // dateOfBirth is the source of truth where it's set; `age` is derived from
  // it on read. A stored age silently goes stale every birthday, which would
  // quietly drift the calorie maths — a birth date never does. `age` stays
  // for accounts that only ever gave a number.
  dateOfBirth   DateTime?
  age           Int?
  activityLevel ActivityLevel?
  nutritionGoal NutritionGoal?

  // First-run state. A null onboardedAt is what routes a new account into the
  // survey; tourCompletedAt is separate so someone can finish the survey, bail
  // out of the tour, and not be sent back through both.
  checkinCadence      CheckinCadence @default(WEEKLY)

  onboardedAt         DateTime?
  tourCompletedAt     DateTime?

  // Self-reported context from onboarding, all editable afterwards. `goals`
  // uses the same vocabulary the peptide reference is tagged with, so a stated
  // goal maps straight onto both peptides and nutrient priorities.
  goals               String[] @default([])
  medications         String[] @default([])
  usedPeptidesBefore  Boolean?
  priorExperienceNote String?

  appOpens       AppOpen[]
  refreshTokens  RefreshToken[]
  stackItems     StackItem[]
  checkins       Checkin[]
  nutritionPlans NutritionPlan[]
  nutritionLogs  NutritionLog[]
}

// Allows logging out of a single device and rotating refresh tokens without
// invalidating every session — a bare "one secret in the JWT" approach can't do that.
/*
One row per day the user opened the app.

A rest day asks nothing of the protocol, so there is no dose to log and
nothing that could prove the day was kept. Showing up is the only signal
available, which is why "days on protocol" counts it.

Stored as a date at midnight rather than a timestamp, with a unique
constraint on the pair, so repeated opens on one day collapse to a single
row and the streak can't be inflated by relaunching.
*/
model AppOpen {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@unique([userId, day])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model StackItem {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  peptideName  String
  dose         Float
  unit         String
  /*
    Free text, shown to the reader: "Twice daily", "2-3x daily", "2x/week
    (DAC)". It is copied from the peptide reference and is editable, so it
    cannot be the source of truth for anything the app computes.
  */
  frequency    String
  /*
    How many doses this item asks for on a day it is scheduled.

    The app had no such field and assumed one. Every day was collapsed to a
    Set of item ids in five places, so a second dose of the same compound had
    nowhere to be recorded: the row went disabled after the first one and the
    user simply could not log the rest of their day. Four peptides in the
    reference library ship multi-per-day frequencies, so this was not a
    hypothetical.

    Defaulted to 1, which makes every row that existed before this field
    correct without a backfill.
  */
  dosesPerDay  Int       @default(1)
  scheduleDays Int[]
  route        String?
  startedAt    DateTime  @default(now())
  cycleOnDays  Int?
  cycleOffDays Int?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  injectionLogs InjectionLog[]

  @@index([userId])
}

model InjectionLog {
  id          String    @id @default(cuid())
  stackItemId String
  stackItem   StackItem @relation(fields: [stackItemId], references: [id], onDelete: Cascade)
  // Null for routes with nowhere to pin — oral capsules, nasal sprays. The
  // dose still happened, so the log still exists.
  site        String?
  takenAt     DateTime  @default(now())
  notes       String?

  @@index([stackItemId])
}

model Checkin {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg     Float?
  bodyFatPct   Float?
  energy       Int?
  mood         Int?
  notes        String?
  /// Feeling words picked from chips during check-in. A Postgres text[]
  /// rather than a join table: they are a closed-ish vocabulary with no
  /// attributes of their own, and nothing will ever ask who felt tired.
  tags         String[] @default([])
  createdAt    DateTime @default(now())

  photos CheckinPhoto[]

  @@index([userId])
}

model CheckinPhoto {
  id        String  @id @default(cuid())
  checkinId String
  checkin   Checkin @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  angle     String // "front" | "side" | "back"
  url       String

  @@index([checkinId])
}

model NutritionPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  title     String
  content   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal      String
  notes     String?
  loggedAt  DateTime @default(now())

  @@index([userId])
}
